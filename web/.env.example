# Copy this file to .env.local and fill in your YouCam API key
# Never commit .env.local to version control

# YouCam API configuration
YOUCAM_API_KEY=your_api_key_here
YOUCAM_API_BASE=https://yce-api-01.makeupar.com

# Local data storage
DATA_DIR=../.data

# Persistence driver. Vercel defaults to Supabase and refuses local storage.
STORAGE_DRIVER=local
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Unit budget management
UNIT_RESERVE_FLOOR=450
VISITOR_UNIT_CAP=20

# Iris measurement (average adult iris width)
IRIS_MM=11.7

# Admin authentication
ADMIN_TOKEN=your_admin_token_here
CRON_SECRET=replace-with-a-long-random-cleanup-secret
# Optional server-only fallback key; selected only on confirmed exhausted primary balance
YOUCAM_API_KEY_FALLBACK=
